#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define FUN  3

/*
 * Port of crkbd.layout.json for the 42-key Jorne/Corne layout:
 * 18 left matrix keys, 3 left thumbs, 18 right matrix keys, 3 right thumbs.
 * The source VIA backup has six non-physical KC_NO padding slots; they are
 * deliberately omitted here.
 *
 * FN_MO13 and FN_MO23 are inferred as the momentary NAV and SYM layers.
 * The VIA export contains no binding that activates FUN.
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp LSHFT &kp A     &kp S     &kp D     &kp F     &kp G
                &kp LCTRL &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp LGUI  &mo NAV   &kp SPACE

                &kp BSPC  &kp P     &kp O     &kp I     &kp U     &kp Y
                &kp APOS  &kp SEMI  &kp L     &kp K     &kp J     &kp H
                &kp ESC   &kp SLASH &kp DOT   &kp COMMA &kp M     &kp N
                &kp RGUI  &mo SYM   &kp ENTER
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp TAB   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp LSHFT &none     &kp HOME  &kp PG_DN &kp PG_UP &kp END
                &kp LCTRL &none     &none     &none     &none     &none
                &kp LGUI  &trans    &kp SPACE

                &kp BSPC  &kp N0    &kp N9    &kp N8    &kp N7    &kp N6
                &kp CAPS  &none     &kp RIGHT &kp UP    &kp DOWN  &kp LEFT
                &kp DEL   &none     &none     &none     &none     &none
                &kp RGUI  &trans    &kp ENTER
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                &kp TAB   &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)
                &kp LCTRL &kp CAPS   &kp HOME   &kp PG_UP   &kp PG_DN   &kp END
                &kp LSHFT &none      &none      &none       &none       &none
                &kp LGUI  &trans     &kp SPACE

                &kp BSPC  &kp LS(N0) &kp LS(N9) &kp LS(N8) &kp LS(N7) &kp LS(N6)
                &kp GRAVE &kp BSLH   &kp RBKT   &kp LBKT   &kp EQUAL  &kp MINUS
                &kp TILDE &kp PIPE   &kp RBRC   &kp LBRC   &kp PLUS   &kp UNDER
                &kp RALT  &trans     &kp ENTER
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &bootloader &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
                &none       &none   &none   &none   &none   &none
                &none       &none   &none   &none   &none   &kp K_MENU
                &kp LGUI    &trans  &kp SPACE

                &kp F11     &kp F10 &kp F9  &kp F8  &kp F7  &kp F6
                &kp F12     &none   &none   &none   &none   &none
                &none       &none   &none   &none   &none   &none
                &kp RALT    &trans  &kp ENTER
            >;
        };
    };
};
